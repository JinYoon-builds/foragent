+def interrupted_pair(case, monkeypatch, *, size=3, regression=True, crash=False):
+    shared_locks(case)
+    case.config = replace(case.config, merge_batch_size=size)
+    case.ctx.config = case.config
+    case.pending_checkpoint = True
+    if regression:
+        update_base(case, {"tests/acceptance/test_intermediate.py":
+            "from pathlib import Path\ndef test_intermediate():\n"
+            "    assert not (Path('src/member_5.py').exists() and "
+            "Path('src/member_1.py').exists() and not Path('src/member_4.py').exists())\n"})
+    queue_workers(case, [5, 1, 4, 2])
+    merge = case.tracker.merge_pr
+
+    def interrupted(pr, **kwargs):
+        if pr == support.pr_for(case, 4).number:
+            if crash:
+                raise KeyboardInterrupt("Owner crashed during landing")
+            raise TrackerError("Merge API unavailable")
+        return merge(pr, **kwargs)
+
+    monkeypatch.setattr(case.tracker, "merge_pr", interrupted)
+    for _ in range(size + 1):
+        if crash:
+            try:
+                support.gate(case)
+            except KeyboardInterrupt:
+                break
+        else:
+            support.gate(case)
+        if len(case.merges) == 2:
+            break
+    assert [m["pr"] for m in case.merges] == [support.pr_for(case, n).number for n in [5, 1]]
+    assert not merge_owner.may_write_target(case.ctx, "main")
